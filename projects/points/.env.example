# Copy to .env.local (never commit real keys). With no STRIPE_SECRET_KEY the
# app runs payments in test mode on the device.

# Stripe secret key. Use the test key (sk_test_...) until you're ready to launch.
STRIPE_SECRET_KEY=

# Price IDs for the two plans, created in Stripe as recurring prices:
#   $99.00 per year and $12.00 per month.
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=

# Signing secret for the webhook endpoint at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Slack incoming webhook for the Contact us form (/api/contact). Without it,
# messages are only written to the server log.
CONTACT_SLACK_WEBHOOK_URL=
