# Copy to .env.local for local dev (never commit real values). In production
# these are set in the Vercel project. Every value is optional locally: with
# nothing set the app runs payments in test mode, uses STAGING data through
# your gcloud login, and logs Slack messages to the terminal.

# --- Site ---
# Public URL, used for link previews.
NEXT_PUBLIC_SITE_URL=https://points.tracetravel.co
# "prod" in the production Vercel project only. Anything else uses staging_* collections.
TRACE_ENV=

# --- Stripe ---
# Secret and publishable keys (sk_/pk_test_... while testing, live for launch).
# Real payments turn on only when both are set.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring price ids: $99.00 per year and $12.00 per month.
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=
# The exit gift: $59.99 per year, offered once to people who back out of checkout.
STRIPE_PRICE_ANNUAL_GIFT=
# Signing secret for the webhook endpoint at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# --- Firebase (accounts) ---
# Service account for project trace-ai-b9cba, same variables as the admin web.
# Locally you can leave these empty and run `gcloud auth application-default login`.
FIREBASE_PROJECT_ID=trace-ai-b9cba
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Signs the sign-in cookie. Any long random string, e.g. `openssl rand -base64 32`.
POINTS_SESSION_SECRET=
# Password for the /admin analytics page. Locally it's "dev" when unset; in production /admin stays locked until this is set.
POINTS_ADMIN_PASSWORD=

# --- Team inbox ---
# Slack incoming webhook for the Points channel: new trials, contact messages,
# seat checks, trip requests, watches, and trial reminders to send by hand.
POINTS_SLACK_WEBHOOK_URL=

# --- Email (trial reminders) ---
# Resend API key and a sender on a verified domain. Without them, reminders
# are posted to Slack for the team to send.
RESEND_API_KEY=
POINTS_EMAIL_FROM=

# --- Meta ads ---
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token (Events Manager → Settings).
META_CAPI_TOKEN=
